# Copy to .env and fill in real values. Never commit the real .env.

# Postgres connection string.
DATABASE_URL=postgresql://password_manager:password_manager@localhost:5432/password_manager

# Secret used to sign session JWTs. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Server Key — one server-wide key that locks every user's Vault Key.
# Must be 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and never commit the real value; rotating it makes every
# stored Vault Key unrecoverable, so treat it like a root credential.
SERVER_KEY=generate-a-32-byte-base64-key-see-comment-above

PORT=4000
NODE_ENV=development
