generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")

  credentials Credential[]
  vaultKey    VaultKey?

  @@map("users")
}

// One row per user, holding their Vault Key locked with the server-wide Server
// Key. `lockedKey` is the opaque output of vaultKeyLock.lockVaultKey() — the
// Vault Key is never stored in the clear. Kept in its own table (not columns on
// User) so Phase 7 can add more unlock methods as inserts, no rewrite.
model VaultKey {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  lockedKey String   @map("locked_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vault_keys")
}

model Credential {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  url       String?
  username  String?
  // Output of vaultCrypto.encrypt(). Today that's a no-op, so this is plaintext —
  // the column stays a plain string when real encryption replaces the seam.
  password  String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credentials")
}
