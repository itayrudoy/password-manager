generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")

  credentials Credential[]
  vaultKey    VaultKey?

  @@map("users")
}

// One row per user, holding their Vault Key locked with the server-wide Server
// Key. `lockedKey` is the opaque output of vaultKeyLock.lockVaultKey() — the
// Vault Key is never stored in the clear. Kept in its own table (not columns on
// User) so Phase 7 can add more unlock methods as inserts, no rewrite.
model VaultKey {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  lockedKey String   @map("locked_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vault_keys")
}

// A vault item, encrypted in the browser under the user's Vault Key (PM-11).
// The server stores only opaque ciphertext + bookkeeping — it can no longer read
// any secret content. Each item is two independent blobs:
//   - overviewCiphertext: title, url, username (the fields the list renders)
//   - secretCiphertext:   password, notes (revealed on demand)
// Each blob is a self-contained base64 token (IV ‖ ciphertext‖tag). `version` is
// the crypto/envelope version, bound into the client's AAD so it's tamper-evident;
// the payload's own field-schema version lives inside the encrypted JSON.
model Credential {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  version            Int      @default(1)
  overviewCiphertext String   @map("overview_ciphertext")
  secretCiphertext   String   @map("secret_ciphertext")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credentials")
}
